# Copy to .env.local for dev; set these in Vercel Project Settings for prod.
# The site renders and builds fine with ALL of these unset — each integration
# simply stays dormant until its key is present.

# --- Lead delivery (set at least one BEFORE spending on ads) -----------------
# CRM webhook — every lead (step-1 partial and full) is POSTed here as JSON.
CRM_WEBHOOK_URL=
# Resend (resend.com) for instant email alerts to Sum's phone.
RESEND_API_KEY=
LEAD_ALERT_FROM="House Sold NJ <leads@housesoldnj.com>"
LEAD_ALERT_TO=sumeetsancheti97@gmail.com
# Optional Slack incoming-webhook for a second alert channel.
SLACK_WEBHOOK_URL=

# --- Address autocomplete ----------------------------------------------------
# Google Places API key, restricted to housesoldnj.com in the Google console.
# Without it the form falls back to a plain address field (still works).
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# --- Measurement -------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
# CallRail dynamic-number-insertion script src, e.g.
# //cdn.callrail.com/companies/123456789/abcdef123456/12/swap.js
NEXT_PUBLIC_CALLRAIL_SRC=
# Google Ads account tag (site-wide base + remarketing), e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GADS_ID=
# Google Ads conversion label (fires on /thank-you), e.g. AW-XXXXXXXXX/YYYYYYYY
NEXT_PUBLIC_GADS_CONVERSION=

# NOTE: the NEXT_PUBLIC_* values above are committed for production in
# .env.production (they're client-visible by design). Only real secrets
# (webhook URLs, RESEND_API_KEY) belong exclusively in Vercel env vars.

# --- Lead database + property reports (all optional; site works without) -----
# Postgres connection string. Easiest: Vercel -> Storage -> Create Database ->
# Neon, connected to this project (sets DATABASE_URL automatically). Enables the
# unified lead record, duplicate protection, seller photos, enrichment and the
# internal reports at /admin.
DATABASE_URL=
# Password for /admin (internal lead reports). Use a long passphrase.
ADMIN_PASSWORD=
# Secures the daily cron (deed-data refresh + enrichment retries). Any long
# random string; Vercel sends it automatically to /api/cron/daily.
CRON_SECRET=
# MLS data (RESO Web API) — beds/baths, the property's listing history, and
# active/pending listings nearby. Internal report only; never shown publicly.
# Each feed is optional; set a URL plus EITHER a bearer token OR OAuth2
# client credentials (whichever the MLS issues).
# MOMLS (Flexmls / Spark Platform): the access token is enough — Spark's
# endpoints are tried automatically. Set MLS_MOMLS_URL only to force one.
MLS_MOMLS_TOKEN=
# MLS_MOMLS_URL=
# CJMLS (fill in from the API approval email):
MLS_CJMLS_URL=
MLS_CJMLS_TOKEN=
# ...or instead of a token:
# MLS_CJMLS_CLIENT_ID=
# MLS_CJMLS_CLIENT_SECRET=
# MLS_CJMLS_TOKEN_URL=
# MLS_CJMLS_SCOPE=
# Optional: OData resource name if not "Property".
# MLS_CJMLS_RESOURCE=Property
# Photo check: Claude reads the Street View + satellite pictures for visible
# distress (tarp, boarded windows, overgrown yard…). Optional.
ANTHROPIC_API_KEY=
# Local testing only (never on Vercel): run against an in-process Postgres.
# PGLITE_DIR=/tmp/hsnj-pglite

# --- Acquisition machine (docs/ACQUISITION_SYSTEM.md) -------------------------
# GoHighLevel sub-account Private Integration Token + location id. Enables
# web-lead delivery into GHL (Contact + Property + Opportunity) and the WAVV
# middleware. Also used by `npm run ghl:provision` / `npm run ghl:push`.
GHL_TOKEN=
GHL_LOCATION_ID=
# Sum's GHL user id: Warm/Hot cards and Sum's tasks are assigned to it.
GHL_OWNER_USER_ID=
# Set to "off" only if GHL rejects dndSettings on cold imports.
# GHL_COLD_SMS_DND=off
# WAVV webhook signing secret (whsec_...) and public API key (transcripts,
# daily reconciliation). Webhook URL: https://www.housesoldnj.com/api/hooks/wavv
WAVV_WEBHOOK_SECRET=
WAVV_API_KEY=
